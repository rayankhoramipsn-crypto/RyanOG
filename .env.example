# Server-side delivery configuration only. Do not put secrets in browser assets.
# Defaults deliberately prevent external delivery. See docs/TRISOCMD_COMMUNICATIONS_VERIFICATION.md.
EMAIL_DELIVERY_ENABLED=false
EMAIL_SENDER_VERIFIED=false
WEB_PUSH_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
DELIVERY_WORKER_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the Edge runtime.
